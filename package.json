    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.57.0",
    "next": "^15.5.28",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "pg-boss": "^10.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "resend": "^6.33.0",
    "robots-parser": "^3.0.1",
    "rss-parser": "^3.13.0",
    "tailwind-merge": "^3.7.0",
