# ── Required ────────────────────────────────────────────────
# Managed Postgres connection string (Railway, Neon, Supabase, RDS…)
DATABASE_URL="postgresql://user:password@host:5432/radar"
# Public URL of the web app (used in email links and auth callbacks)
APP_URL="https://radar.yourdomain.com"
# 32+ random chars:  openssl rand -base64 32
AUTH_SECRET=""
# Comma-separated emails allowed to sign in. Everyone else is rejected.
ALLOWED_EMAILS="you@example.com"

# ── Email (sign-in links + daily report) ───────────────────
# https://resend.com — verify your sending domain first
RESEND_API_KEY=""
EMAIL_FROM="Opportunity Radar <radar@yourdomain.com>"

# ── AI research (Claude API) ───────────────────────────────
# https://console.anthropic.com — without it: no listing extraction, discovery or research
ANTHROPIC_API_KEY=""
AI_MODEL="claude-sonnet-5-5"
# Set from Anthropic's pricing page to enable USD cost tracking + the daily budget cap
AI_INPUT_USD_PER_MTOK=""
AI_OUTPUT_USD_PER_MTOK=""
AI_WEB_SEARCH_USD_PER_1K="10"
AI_DAILY_BUDGET_USD="5"
RESEARCH_MAX_PER_RUN="5"
DISCOVERY_MAX_SEARCHES="6"

# ── Optional ───────────────────────────────────────────────
# Free key: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=""
# Google sign-in (optional): https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
